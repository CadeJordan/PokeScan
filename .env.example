# PSA Public API bearer token. Generate at:
# https://www.psacard.com/publicapi/documentation
PSA_API_TOKEN=

# eBay Browse API credentials. Create an app at:
# https://developer.ebay.com/my/keys  (Production -> App ID + Cert ID)
# Default scope is fine; the client uses client_credentials OAuth.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_MARKETPLACE=EBAY_US

# Where downloaded card images and the SQLite metadata DB live.
DATA_DIR=./data
IMAGES_DIR=./data/images
DB_PATH=./data/pokescan.sqlite

# Where trained model artifacts (TorchScript / ONNX) are stored.
MODELS_DIR=./data/models
ACTIVE_MODEL_PATH=./data/models/grade_model.onnx

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# W&B / MLflow (optional)
WANDB_PROJECT=pokescan
WANDB_MODE=disabled
